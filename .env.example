# .env.example — variáveis de ambiente para vite dev (SvelteKit SSR local)
# Copie para .env.local. NÃO versionar .env.local.
#
# Para wrangler dev, use .dev.vars (ver .dev.vars.example).

# Ambiente
PUBLIC_ENVIRONMENT=development

# Cloudflare Turnstile (chave de teste — sempre aprova)
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ── LEGADO (manter enquanto aplicação Supabase estiver ativa) ─────────────────
PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
