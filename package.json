{
  "name": "vturapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "cf:build": "npm run build && node scripts/inject-scheduled.mjs",
    "cf:deploy": "npm run cf:build && npx wrangler deploy",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest --dir src --run",
    "api:inventory": "node scripts/api-inventory.mjs",
    "api:inventory:check": "node scripts/api-inventory.mjs --check",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:watch": "vitest --dir src",
    "d1:local:create": "wrangler d1 execute vturapp-db --local --command \"SELECT 1\"",
    "d1:migrate:local": "wrangler d1 migrations apply vturapp-db --local",
    "d1:migrate:staging": "wrangler d1 migrations apply vturapp-db-staging --env staging",
    "d1:migrate:prod": "wrangler d1 migrations apply vturapp-db --env production",
    "dev:cf": "wrangler dev --local",
    "cf:deploy:staging": "npm run cf:build && npx wrangler deploy --env staging",
    "legacy:patch-scheduled": "node scripts/patch-worker-scheduled.js",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:push:local": "drizzle-kit push --config drizzle.config.ts",
    "drizzle:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/eslint": "^9.6.0",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.36.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.2",
    "prettier-plugin-svelte": "^3.2.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.92.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.4",
    "wrangler": "^4.87.0",
    "yaml": "^2.8.4",
    "drizzle-kit": "^0.31.11"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.20",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.0.0",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.2",
    "fflate": "^0.8.2",
    "flowbite-svelte": "^1.33.1",
    "flowbite-svelte-icons": "^2.0.0",
    "hono": "^4.11.9",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-svelte": "^1.0.1",
    "pdfjs-dist": "^5.7.284",
    "svelte-bottom-sheet": "^2.3.0",
    "tailwind-merge": "^3.7.0",
    "drizzle-orm": "^0.45.4"
  },
  "type": "module",
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    }
  }
}
